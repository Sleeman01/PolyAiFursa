#!/bin/bash
set -euxo pipefail

# --- disable swap ---
swapoff -a
sed -i '/ swap / s/^/#/' /etc/fstab

# --- kernel modules & sysctl ---
cat <<MODULES | tee /etc/modules-load.d/k8s.conf
overlay
br_netfilter
MODULES
modprobe overlay
modprobe br_netfilter

cat <<SYSCTL | tee /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
SYSCTL
sysctl --system

# --- install cri-o ---
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y software-properties-common curl gpg apt-transport-https ca-certificates unzip

curl -fsSL https://pkgs.k8s.io/addons:/cri-o:/prerelease:/main/deb/Release.key |
  gpg --dearmor -o /etc/apt/keyrings/cri-o-apt-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/cri-o-apt-keyring.gpg] https://pkgs.k8s.io/addons:/cri-o:/prerelease:/main/deb/ /" |
  tee /etc/apt/sources.list.d/cri-o.list
apt-get update
apt-get install -y cri-o
systemctl enable --now crio

# --- install kubelet, kubeadm ---
curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.30/deb/Release.key |
  gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.30/deb/ /" |
  tee /etc/apt/sources.list.d/kubernetes.list
apt-get update
apt-get install -y kubelet kubeadm
apt-mark hold kubelet kubeadm

# --- install AWS CLI (to read SSM) ---
if ! command -v aws &> /dev/null; then
  curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
  unzip -q awscliv2.zip
  ./aws/install
fi

# --- set node labels for AWS zone/region before kubelet starts ---
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
AZ=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)
echo "KUBELET_EXTRA_ARGS=--node-labels=topology.kubernetes.io/zone=$AZ,topology.kubernetes.io/region=${region}" | tee /etc/default/kubelet

# --- fetch join command from SSM and join (idempotent guard) ---
if [ ! -f /etc/kubernetes/kubelet.conf ]; then
  for i in $(seq 1 30); do
    JOIN_CMD=$(aws ssm get-parameter \
      --region ${region} \
      --name "/sleeman/${cluster_name}/join-command" \
      --with-decryption \
      --query "Parameter.Value" \
      --output text 2>/dev/null || true)

    if [ -n "$JOIN_CMD" ]; then
      # Verify we can actually reach the control plane's API port before trusting this join command
      # (guards against a stale value from a previous cluster incarnation)
      CP_ADDR=$(echo "$JOIN_CMD" | awk '{print $3}')
      CP_HOST=$(echo "$CP_ADDR" | cut -d: -f1)
      CP_PORT=$(echo "$CP_ADDR" | cut -d: -f2)
      if timeout 5 bash -c "cat < /dev/null > /dev/tcp/$CP_HOST/$CP_PORT" 2>/dev/null; then
        echo "Control plane at $CP_ADDR is reachable, proceeding with join"
        break
      else
        echo "Join command points to $CP_ADDR but it is not reachable yet (likely a stale value) - retrying"
        JOIN_CMD=""
      fi
    fi

    echo "Waiting for control plane join command in SSM..."
    sleep 20
  done
  eval "$JOIN_CMD"
fi
